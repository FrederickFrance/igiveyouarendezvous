{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FrederickFrance/igiveyouarendezvous/main/schema/problem.schema.json",
  "title": "igiveyouarendezvous problem",
  "description": "Everything to plan: recruiters, candidates with the recruiters they must meet, availabilities and settings. Read in YAML or JSON.",
  "type": "object",
  "required": [
    "recruiters",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This schema, for editors; ignored."
    },
    "from": {
      "$ref": "#/$defs/date",
      "description": "First day of the period to plan (the command may give another one)."
    },
    "to": {
      "$ref": "#/$defs/date",
      "description": "Last day of the period to plan, included (from by default)."
    },
    "not-before": {
      "$ref": "#/$defs/date",
      "description": "To plan again in the middle of the period: the first date of new interviews; the fixed interviews of the -start plan may come before."
    },
    "weekdays": {
      "description": "The days of the week with interviews (Monday to Friday by default).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "mon",
          "Mon",
          "MON",
          "tue",
          "Tue",
          "TUE",
          "wed",
          "Wed",
          "WED",
          "thu",
          "Thu",
          "THU",
          "fri",
          "Fri",
          "FRI",
          "sat",
          "Sat",
          "SAT",
          "sun",
          "Sun",
          "SUN",
          "monday",
          "Monday",
          "MONDAY",
          "tuesday",
          "Tuesday",
          "TUESDAY",
          "wednesday",
          "Wednesday",
          "WEDNESDAY",
          "thursday",
          "Thursday",
          "THURSDAY",
          "friday",
          "Friday",
          "FRIDAY",
          "saturday",
          "Saturday",
          "SATURDAY",
          "sunday",
          "Sunday",
          "SUNDAY"
        ]
      }
    },
    "closed": {
      "description": "Dates without interviews, such as holidays.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/date"
      }
    },
    "day": {
      "$ref": "#/$defs/spans",
      "description": "Default availability of everybody, every day (08:00-12:00 by default)."
    },
    "breaks": {
      "$ref": "#/$defs/spans",
      "description": "Times without interviews, every day, such as lunch; two interviews of a candidate on a same day never lie on both sides of a break. The longest break separates the morning from the afternoon."
    },
    "duration": {
      "$ref": "#/$defs/duration",
      "description": "Default interview length (1h by default)."
    },
    "step": {
      "$ref": "#/$defs/duration",
      "description": "Time grid: interviews start on multiples of it (automatic by default)."
    },
    "min-gap": {
      "$ref": "#/$defs/gap",
      "description": "The least time between two interviews of a candidate (0 by default)."
    },
    "max-gap": {
      "description": "The most time between two interviews of a candidate: 0 (the default) chains the interviews; \"unlimited\" removes the limit.",
      "oneOf": [
        {
          "$ref": "#/$defs/gap"
        },
        {
          "const": "unlimited"
        }
      ]
    },
    "joint-groups": {
      "description": "Groups of recruiters who may interview a candidate together (allowed, not required).",
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "panels": {
      "description": "Groups of recruiters who always interview together, such as a jury: a candidate meets the members of a panel they need at once, with nobody else. A recruiter is in one panel at most, and then in no joint group.",
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "max-joint-size": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum recruiters in a joint interview (0: no limit)."
    },
    "objectives": {
      "description": "The objectives, most important first (see igiveyouarendezvous -list-objectives).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "priorities",
          "urgency",
          "complete-candidates",
          "meetings",
          "recruiters",
          "recruiter-half-days",
          "interviews",
          "recruiter-span",
          "candidate-wait",
          "earliest",
          "day-end"
        ]
      }
    },
    "recruiters": {
      "description": "The recruiters, by name; a recruiter without settings takes the defaults.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "duration": {
            "$ref": "#/$defs/duration",
            "description": "Length of an interview with this recruiter; a joint interview lasts as long as its longest part."
          },
          "availability": {
            "$ref": "#/$defs/availability"
          }
        }
      }
    },
    "candidates": {
      "description": "The candidates, by name.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "meet"
        ],
        "additionalProperties": false,
        "properties": {
          "meet": {
            "description": "The recruiters to meet: a list, in any order, or the recruiters with their ranks (1 first, then 2..., X any time), the length of the meeting (15m, 1h30: a bare number is a rank), or both: {rank: 1, duration: 15m}.",
            "oneOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/name"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*(?:[Xx]|[Aa][Nn][Yy])\\s*$"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^\\s*(?:\\d+h\\d+|(?:\\d+(?:\\.\\d+)?(?:h|m|s))+)\\s*$"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "rank": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 1
                            },
                            {
                              "type": "string",
                              "pattern": "^\\s*(?:[Xx]|[Aa][Nn][Yy])\\s*$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "duration": {
                          "type": "string",
                          "pattern": "^\\s*(?:\\d+h\\d+|(?:\\d+(?:\\.\\d+)?(?:h|m|s))+)\\s*$"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "One candidate outranks any number of candidates of lower priority (1 by default)."
          },
          "duration": {
            "$ref": "#/$defs/duration",
            "description": "Length of the interviews of this candidate, in place of the recruiters' ones (the length of a meeting, for instance)."
          },
          "together": {
            "type": "boolean",
            "description": "A meeting: all the recruiters at once, in one interview, whatever the joint groups, or not at all (false by default). No ranks in meet then."
          },
          "availability": {
            "$ref": "#/$defs/availability"
          }
        }
      }
    }
  },
  "$defs": {
    "spans": {
      "description": "Time spans, such as \"08:00-12:00, 14:00-17:00\" (or 8h-12h), or a list of spans; \"none\": never.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\s*(?:[Nn][Oo][Nn][Ee]|\\d{1,2}(?:[:hH]\\d{2}|[hH])?\\s*-\\s*\\d{1,2}(?:[:hH]\\d{2}|[hH])?(?:\\s*,\\s*\\d{1,2}(?:[:hH]\\d{2}|[hH])?\\s*-\\s*\\d{1,2}(?:[:hH]\\d{2}|[hH])?)*)\\s*$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\s*(?:[Nn][Oo][Nn][Ee]|\\d{1,2}(?:[:hH]\\d{2}|[hH])?\\s*-\\s*\\d{1,2}(?:[:hH]\\d{2}|[hH])?(?:\\s*,\\s*\\d{1,2}(?:[:hH]\\d{2}|[hH])?\\s*-\\s*\\d{1,2}(?:[:hH]\\d{2}|[hH])?)*)\\s*$"
          }
        }
      ]
    },
    "duration": {
      "description": "A length of time: 45m, 1h, 1h30, 1h30m, or a number of minutes.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\s*(?:\\d+|\\d+h\\d+|(?:\\d+(?:\\.\\d+)?(?:h|m|s))+)\\s*$"
        }
      ]
    },
    "gap": {
      "description": "A time between two interviews: a duration (0, 30m, 1h30, a number of minutes) or a number of calendar days (3d, 3 days).",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\s*(?:(?:\\d+|\\d+h\\d+|(?:\\d+(?:\\.\\d+)?(?:h|m|s))+)|\\d+\\s*(?:d|days?))\\s*$"
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "A date: 2026-11-03."
    },
    "availability": {
      "description": "When the person is available: time spans valid every day, or time spans by date (absent on the other dates).",
      "oneOf": [
        {
          "$ref": "#/$defs/spans"
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/date"
          },
          "additionalProperties": {
            "$ref": "#/$defs/spans"
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
